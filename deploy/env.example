# Copiez en .env (chmod 600). Variables lues par compose.yml et par les scripts de ce dossier.
DOMAIN=primes.exemple.ch
STAGING_DOMAIN=staging.primes.exemple.ch
# Adresse donnée à Let's Encrypt (avis d'expiration des certificats).
ACME_EMAIL=vous@exemple.ch
# Version en production : un tag sha-… publié par la CI (voir deploy.sh), jamais « latest ».
APP_TAG=sha-0000000
# Version en staging : par défaut la dernière publiée.
STAGING_TAG=latest
# Accès au staging (en plus des comptes de l'app) : `docker run --rm -it caddy:2.10-alpine caddy hash-password`.
# Mettez le hachage entre apostrophes simples : sinon compose interprète ses « $ ».
STAGING_AUTH_USER=nathan
STAGING_AUTH_HASH=''
# Surveillance (facultatif) : URL de ping d'un service comme healthchecks.io.
WATCHDOG_PING_URL=
RESTORE_PING_URL=
