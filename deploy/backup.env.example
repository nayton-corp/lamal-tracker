# Copiez en backup.env (chmod 600). Stockage objet compatible S3, de préférence en Suisse.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
BACKUP_BUCKET=primes-lamal-sauvegardes
BACKUP_ENDPOINT=https://s3.exemple.ch
BACKUP_REGION=ch
# Chiffrement des sauvegardes : `docker run --rm alpine sh -c "apk add -q age && age-keygen"`.
# La clé publique (age1…) chiffre ; la clé privée (AGE-SECRET-KEY-…) relit. Gardez une copie de
# la clé privée HORS du serveur (gestionnaire de mots de passe) : sans elle, pas de restauration.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
