# HTTPS automatique (Let's Encrypt), TLS 1.2 et 1.3, HSTS. Pas de journal d'accès : les adresses
# IP et les URL des visiteurs ne sont pas conservées.
{
	email {$ACME_EMAIL}
}

(commun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		# Fichier de primes OFSP (≈ 20 Mo) ou police PDF importés.
		max_size 30MB
	}
}

{$DOMAIN} {
	import commun
	reverse_proxy app:3000
}

# Staging : chaque nouvelle version y passe avant la production. Réservé à l'exploitant.
{$STAGING_DOMAIN} {
	import commun
	header X-Robots-Tag "noindex, nofollow"
	basic_auth {
		{$STAGING_AUTH_USER} {$STAGING_AUTH_HASH}
	}
	reverse_proxy staging:3000
}
