# Copiez en staging.env (chmod 600). Même app, données séparées, pas d'envoi réel.
APP_URL=https://staging.primes.exemple.ch
CONTACT_EMAIL=contact@exemple.ch
OPERATOR_NAME=Prénom Nom
OPERATOR_ADDRESS=Rue Exemple 1; 1000 Lausanne
# Les courriels du staging restent dans le volume (data/staging/mail), rien ne part.
MAIL_DIR=/data/mail
# Code d'installation, obligatoire comme en production : `openssl rand -hex 16`.
SETUP_TOKEN=
# Pingen en environnement de test uniquement :
# PINGEN_STAGING=true
