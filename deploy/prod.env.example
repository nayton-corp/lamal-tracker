# Copiez en prod.env (chmod 600). Configuration de l'app de production (voir docs/exploitation/configuration.md).
APP_URL=https://primes.exemple.ch
CONTACT_EMAIL=contact@exemple.ch
OPERATOR_NAME=Prénom Nom
OPERATOR_ADDRESS=Rue Exemple 1; 1000 Lausanne
# Courriel transactionnel (prestataire suisse ou européen, domaine authentifié SPF/DKIM/DMARC).
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.ch:465
MAIL_FROM=Primes LAMal <no-reply@exemple.ch>
VAPID_SUBJECT=mailto:contact@exemple.ch
# Code d'installation, obligatoire (APP_URL en https) : exigé pour créer le compte administrateur
# ou redéfinir son mot de passe. `openssl rand -hex 16`.
SETUP_TOKEN=
# Ping horaire du planificateur (facultatif) : alerte si l'app ou ses tâches de fond s'arrêtent.
HEALTHCHECK_PING_URL=
# Pingen (facultatif, réservé aux foyers autorisés dans l'administration) :
# PINGEN_CLIENT_ID=
# PINGEN_CLIENT_SECRET=
# PINGEN_ORGANISATION_ID=
